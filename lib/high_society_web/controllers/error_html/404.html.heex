<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#002349" />
    <title>Page not found · High Society</title>
    <link rel="icon" type="image/png" sizes="192x192" href={~p"/images/icons/icon-192.png"} />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="error-page-bg min-h-screen flex items-center justify-center px-6 py-16 text-white">
    <div class="max-w-lg w-full text-center">
      <a href="/" class="inline-flex items-center gap-2 mb-10">
        <.icon name="hero-rectangle-stack-solid" class="size-7 text-[#957c3d]" />
        <span class="text-lg font-bold tracking-tight">High Society</span>
      </a>

      <p class="text-8xl font-black tracking-tight text-[#957c3d]">404</p>

      <h1 class="mt-4 text-2xl font-semibold">This table's already folded</h1>

      <p class="mt-3 text-white/70">
        The page you're looking for doesn't exist, moved, or never dealt in.
        Let's get you back to the felt.
      </p>

      <a
        href="/"
        class="btn btn-lg mt-8 border-none bg-[#957c3d] text-[#002349] hover:bg-[#ab8f49]"
      >
        <.icon name="hero-home-solid" class="size-5" /> Back to the lobby
      </a>
    </div>
  </body>
</html>
